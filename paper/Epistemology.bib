@article{EPfDyG,
	title = {Epistemic protocols for dynamic gossip},
	journal = {Journal of Applied Logic},
	volume = {20},
	pages = {1-31},
	year = {2017},
	issn = {1570-8683},
	doi = {https://doi.org/10.1016/j.jal.2016.12.001},
	url = {https://www.sciencedirect.com/science/article/pii/S1570868316301161},
	author = {Hans {van Ditmarsch} and Jan {van Eijck} and Pere Pardo and Rahim Ramezanian and François Schwarzentruber},
	keywords = {Gossip, Dynamic networks, Distributed protocols, Communication, Epistemic logic, Agents},
	abstract = {A gossip protocol is a procedure for spreading secrets among a group of agents, using a connection graph. In each call between a pair of connected agents, the two agents share all the secrets they have learnt. In dynamic gossip problems, dynamic connection graphs are enabled by permitting agents to spread as well the telephone numbers of other agents they know. This paper characterizes different distributed epistemic protocols in terms of the (largest) class of graphs where each protocol is successful, i.e. where the protocol necessarily ends up with all agents knowing all secrets.}
}

@article{CPM,
